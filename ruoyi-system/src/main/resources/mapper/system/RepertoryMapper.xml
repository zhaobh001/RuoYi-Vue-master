    <select id="GetRepertoryByBarCode" parameterType="Repertory" resultMap="RepertoryResult">
       SELECT
        AA.MATCODE,
        AA.MATNAME,
        SUM(AA.REPQTY) AS REPQTY,
        AA.BATCHNO,
        AA.SN,
        AA.STORESITENO,
        AA.ERP_STOREROOM,
        AA.PALLETNO,
        AA.STOREROOMNO,
        AA.STOREROOMNAME
        FROM(

        SELECT
        PM.MATCODE,
        SS.STORESITENO,
        T.REPQTY,
        T.BATCHNO,
        T.SN,
        SM.STOREROOMNAME,
        T.ERP_STOREROOM,
        T.PALLETNO,
        T.REPERTORYID,
        T.STOREROOMID,
        T.STORESITEID,
        SM.STOREROOMNO,
        PM.MATINNERCODE,
        PM.MATNAME,
        PM.MATUNIT,
        PM.MATMODEL,
        DD.NAME,
        T.REPSTATE,
        DECODE(T.REPSTATE,0,'正常',1,'不良',2,'检验中') AS REPSTATE_nm,
        T.REP_OWNER_NAME,
        T.REP_OWNER_CODE,
        T.ISFROZEN AS ISFROZEN,
        DECODE(T.ISFROZEN,0,'正常',1,'冻结',1,'锁定') AS ISFROZEN_nm,
        p.PARNO,
        P.PARNAME,
        T.CREATETIME,
        T.INSERTTIME,
        TO_NUMBER(T.Occupyqty) AS DATA1,
        T.OCCUPYQTY,
        PT.MATYCODE,
        PT.MATYNAME,
        PM.MATCODECONTROL,
        T.PROJECT_NUM,
        T.ORDERNO,
        NVL(T.WORKSTATION,'无') AS WORKSTATION,
        T.OCCUPY_ORDERNO,
        T.PRODUCTLINE,
        T.WHOLESETNO,
        T.FROZENUSER,
        T.FROZENUSERBAK,
        CASE WHEN T.data8='1' THEN '合格品退库' ELSE '正常' END AS QUALFLG
        FROM REPERTORY T,
        STOREROOM SM,
        STORESITE SS,
        PM_MATERIAL PM,
        PM_MATTYPE PT,
        PARTNER P,
        BB_DICTIONARY DD
        WHERE T.STOREROOMID =SM.STOREROOMID(+)
        AND T.STORESITEID =SS.STORESITEID(+)
        AND T.MATERIALID =PM.PM_MATERIALID
        AND PM.PM_MATTYPEID =PT.PM_MATTYPEID
        AND T.REPPROVIDER =P.PARTNERID(+)
        AND T.REPQTY >0
        AND DD.BB_DICTIONARYID=PM.MATUNIT(+)
        <if test="storesiteno != null">and SS.storesiteno = #{storesiteno}</if>
        <if test="matCode != null">and pm.matcode = #{matCode}</if>
        <if test="palletno != null">and T.PALLETNO = #{palletno}</if>

        )AA GROUP BY
         AA.MATCODE,
        AA.MATNAME,
        AA.BATCHNO,
        AA.SN,
        AA.STORESITENO,
        AA.ERP_STOREROOM,
        AA.PALLETNO,
        AA.STOREROOMNO,
        AA.STOREROOMNAME

    </select>

    <select id="GetPalletSiteNo" parameterType="String" resultMap="RepertoryResult">
        select
        *
        from
        repertory r
        where 1=1 and r.repqty > 0 and R.palletno = #{palletno} and rownum &lt; 2
    </select>

        <select id="GetRepertoryBySiteNoMatCode" parameterType="Repertory" resultMap="RepertoryResult">

                                             select matcode,
                                                    sum(repqty) as repqty,
                                                    batchno as batchno,
                                                    PROJECT_NUM as PROJECT_NUM,
                                                    storesiteno as storesiteno,
                                                    erp_storeroom as erp_storeroom,
                                                    REP_OWNER_CODE as REP_OWNER_CODE,
                                                    palletno as palletno,
                                                    sn as sn,
                                                    storeroomname as storeroomname
                                               from wms_queryrepertory_vw
                                              where 1=1
                                              <if test="storesiteno != null">and storesiteno = #{storesiteno}</if>
                                              <if test="matCode != null">and matcode = #{matCode}</if>

                                             group by storesiteno, matcode, batchno, sn, storeroomname,erp_storeroom,palletno,PROJECT_NUM,REP_OWNER_CODE
                                             order by storesiteno, matcode, PROJECT_NUM, batchno, sn, erp_storeroom,REP_OWNER_CODE,palletno,storeroomname
    </select>

           <select id="GetRepertoryByStoresiteNoTransfer" parameterType="Repertory" resultMap="RepertoryResult">

                                             select s.storesiteno,
                                                    pm.matcode,
                                                    r.rep_owner_code as parno,
                                                    r.batchno,
                                                    r.sn,
                                                    r.erp_storeroom,
                                                    r.project_num,
                                                    r.rep_owner_code,
                                                    (sum(r.repqty) - nvl(GetCollectQtyBySiteMat(r.storesiteid,r.materialid,r.batchno, r.sn,r.erp_storeroom),0)) as repqty
                                                from repertory r
                                                join storesite s
                                                on s.storesiteid = r.storesiteid
                                                left join partner p
                                                on p.partnerid = r.repprovider
                                                join pm_material pm
                                                on pm.pm_materialid = r.materialid
                                                where r.repqty>0
                                                <if test="targetStoresiteNo == null">and (s.storesiteno = #{sourceStoresiteNo})</if>
                                                <if test="targetStoresiteNo != null">and (s.storesiteno = #{sourceStoresiteNo} or s.storesiteno = #{targetStoresiteNo} )</if>

                                                group by s.storesiteno, pm.matcode,r.storesiteid,r.materialid,r.rep_owner_code, r.batchno, r.sn,r.erp_storeroom,r.project_num
    </select>

               <select id="GetRepertoryTransfer" parameterType="Repertory" resultMap="RepertoryResult">

                                            select s.storesiteno,
                                                        pm.matcode,
                                                        -- p.parno,
                                                        r.*
                                                   from repertory r,
                                                        storesite s,
                                                        -- partner p,
                                                        pm_material pm
                                                  where s.storesiteid = r.storesiteid
                                                    -- and p.partnerid = r.repprovider
                                                    and pm.pm_materialid = r.materialid
                                                    and r.repqty > 0
                                                    and s.storesiteno in (#{filter})
    </select>
