    <select id="selectMtlRepertoryByStoresiteNo3" parameterType="Repertory" resultMap="RepertoryResult">
        select s.storesiteno, --库位代码,
        pm.matcode, -- 物料代码
        sum(r.repqty) as repqty --库存量
        from repertory r
        join storesite s
        on s.storesiteid = r.storesiteid
        join partner p
        on p.partnerid = r.repprovider
        join pm_material pm
        on pm.pm_materialid = r.materialid
        where pm.matcode = #{matCode}
        and s.storesiteno = #{storeSite}
        and r.repqty > 0
        group by s.storesiteno, pm.matcode
    </select>


     <select id="selectMtlRepertoryByStoresiteNo2" parameterType="Repertory" resultMap="RepertoryResult">
                             select rr.repqty-rr2.COLQTY as repqty from (
                                          SELECT
                                               nvl(sum(r.repqty),0) as repqty --库存量,

                                          from repertory r
                                          join storesite s
                                            on s.storesiteid = r.storesiteid
                                          join pm_material pm
                                            ON PM.PM_MATERIALID = R.MATERIALID

                                         WHERE PM.MATCODE = #{matCode}
                                         AND S.STORESITENO = #{storeSite}
                                         AND R.REPQTY > 0)rr  left join (
                                          SELECT
                                               NVL(SUM(R.QTY),0) AS COLQTY --库存量,
                                          from OUTCOLLECTDATA r
                                          JOIN STORESITE S

                                            ON S.STORESITEID = R.OUTSITE

                                          join pm_material pm
                                            ON PM.PM_MATERIALID = R.MATERIALID

                                         WHERE PM.MATCODE = #{matCode}
                                         AND S.STORESITENO = #{storeSite}
                                         and r.CSTATE =0
                                         )rr2 on 1=1

    </select>

