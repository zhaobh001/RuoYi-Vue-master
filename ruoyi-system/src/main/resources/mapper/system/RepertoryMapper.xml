       from (
        select
        r.rep_owner_code as parno,
        r.batchno,
        r.sn,
        r.erp_storeroom,
        r.project_num,
        r.rep_owner_code,
         r.storesiteid,
        r.materialid,
        SUM(r.repqty) as repqty
        from
        repertory r
        where 1=1 and r.repqty>0
        <if test="storesiteid != null">and R.STORESITEID = #{storesiteid}</if>
        <if test="materialid != null">and R.MATERIALID = #{materialid}</if>
        <if test="erpStoreroom != null">and r.erp_storeroom = #{erpStoreroom}</if>
        <if test="batchno != null">and r.batchno = #{batchno}</if>
        <if test="sn != null">and r.sn = #{sn}</if>
            group by r.rep_owner_code, r.batchno, r.sn, r.erp_storeroom, r.project_num, r.rep_owner_code, r.storesiteid, r.materialid
        )aa where aa.repqty-nvl(GetCollectQtyBySiteMat(aa.storesiteid,aa.materialid,aa.batchno, aa.sn,aa.erp_storeroom),0)>0

    </select>

    <select id="GetRepertoryByStoresiteNoErp" parameterType="Repertory" resultMap="RepertoryResult">
