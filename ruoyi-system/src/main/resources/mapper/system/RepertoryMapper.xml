    <select id="selectLSMtlRepertoryByMatNo" parameterType="Repertory" resultMap="RepertoryResult">
                            select pm.matcode, -- 物料代码,
                                               sum(r.repqty) as repqty  --库存量,
                                          from repertory r
                                          join storesite s
                                            on s.storesiteid = r.storesiteid
                                          join STOREROOM rm
                                            on rm.STOREROOMID = r.STOREROOMID
                                          join pm_material pm
                                            on pm.pm_materialid = r.materialid
                                         where pm.matcode = #{matCode}
                                           and r.repqty > 0 and rm.ALLOTFLAG = 0
                                         group by  pm.matcode
    </select>
    <select id="selectLSMtlRepertoryByStoresiteNo" parameterType="Repertory" resultMap="RepertoryResult">
                            select s.storesiteno, --库位代码,
                                               pm.matcode, -- 物料代码,
                                               sum(r.repqty) as repqty, --库存量,
                                               r.rep_owner_code as parno, --拥有方
                                               r.erp_storeroom,
                                               count(*) as amount
                                          from repertory r
                                          join storesite s
                                            on s.storesiteid = r.storesiteid
                                          join STOREROOM rm
                                            on rm.STOREROOMID = r.STOREROOMID
                                          join partner p
                                            on p.partnerid = r.repprovider
                                          join pm_material pm
                                            on pm.pm_materialid = r.materialid
                                         where pm.matcode = #{matCode}
                                         and s.storesiteno = #{storeSite}
                                         and r.repqty > 0 and rm.ALLOTFLAG = 0
                                         group by s.storesiteno, pm.matcode, rep_owner_code, r.erp_storeroom
    </select>

    <select id="selectMtlRepertoryByMatNo" parameterType="Repertory" resultMap="RepertoryResult">
                            select pm.matcode, -- 物料代码,
                                               sum(r.repqty) as repqty  --库存量,
                                          from repertory r
